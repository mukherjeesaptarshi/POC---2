  "bugs": {
    "url": "https://github.com/mukherjeesaptarshi/POC---2/issues"
  },

  "homepage": "https://github.com/mukherjeesaptarshi/POC---2#readme",

  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/pngjs": "^6.0.5",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },

  "dependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "ajv": "^8.20.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.5.0-canary.20260820T155656"
  }
}